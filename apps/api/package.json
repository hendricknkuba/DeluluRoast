{
  "name": "@delulu-roast/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @delulu-roast/shared build && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @delulu-roast/shared build && node --import tsx --test ./src/*.test.ts ./src/**/*.test.ts"
  },
  "dependencies": {
    "@delulu-roast/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "openai": "^4.73.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
